{
  "name": "xeck",
  "version": "4.4.1",
  "description": "Xeck desktop application, powered by Poyraz",
  "author": "Xeck",
  "private": true,
  "scripts": {
    "build:lib": "npm run build --prefix poyraz",
    "build:host": "npm run build --prefix host",
    "build:web": "npm run build --prefix web",
    "build:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir build/dist-electron --target node20 --external electron",
    "build:desktop": "concurrently -n host,web,electron -c blue,green,yellow \"npm run build:lib && npm run build:host\" \"npm run build:web\" \"npm run build:electron\"",
    "dev": "concurrently -n host,web -c blue,green \"npm run dev:host\" \"npm run dev:web\"",
    "start": "npm run build:lib && npm run build:web && concurrently -n host,web -c blue,green \"npm run start --prefix host\" \"npm run preview --prefix web\"",
    "dev:host": "npm run dev --prefix host",
    "dev:web": "npm run dev --prefix web",
    "test": "npm run typecheck --prefix host && npm run test --prefix host",
    "test:i18n": "node host/node_modules/tsx/dist/cli.mjs --tsconfig web/tsconfig.json --test web/src/i18n/i18n.test.ts",
    "dev:electron": "npm run build:electron && electron .",
    "dist": "npm run build:desktop && electron-builder --publish never",
    "build-release": "npm run build:desktop && electron-builder --win nsis --publish never -c.directories.output=build/release-build",
    "preview:web": "npm run preview --prefix web",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux --publish never",
    "test:updates": "node --test electron/updates.test.cjs",
    "build:desktop:prepared": "concurrently -n host,web,electron -c blue,green,yellow \"npm run build:host\" \"npm run build:web\" \"npm run build:electron\""
  },
  "main": "build/dist-electron/main.js",
  "build": {
    "appId": "com.xeck.desktop",
    "productName": "Xeck",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "files": [
      "build/dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "host/dist/index.js",
        "to": "host/dist/index.js"
      },
      {
        "from": "host/package.json",
        "to": "host/package.json"
      },
      {
        "from": "model_prices_and_context_window.json",
        "to": "model_prices_and_context_window.json"
      },
      {
        "from": "web/dist",
        "to": "web/dist"
      },
      {
        "from": "assets/branding/xeck.png",
        "to": "assets/branding/xeck.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third-party",
        "to": "third-party"
      }
    ],
    "directories": {
      "output": "build/release"
    },
    "win": {
      "icon": "assets/branding/xeck.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "mac": {
      "icon": "assets/branding/xeck.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/branding/xeck.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Septillioner"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Septillioner",
        "repo": "xeck",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Septillioner/xeck",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
